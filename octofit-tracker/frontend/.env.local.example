# Frontend Environment Configuration - Local Development
# Copy this file to .env.local and update with your actual Codespace name

# Required for GitHub Codespace deployments
# This should be the name of your Codespace (e.g., "my-codespace", "copilot-agent-1")
# API endpoints will be constructed as: https://{VITE_CODESPACE_NAME}-8000.app.github.dev/api/
# If not defined, the app will fall back to localhost:8000
VITE_CODESPACE_NAME=your-codespace-name

# Optional: Application name for display
VITE_APP_NAME=OctoFit Tracker

# Optional: API timeout (in milliseconds)
VITE_API_TIMEOUT=5000
